#!/usr/bin/env python3
"""jinx-notice-actions — Jinx's notices WITH BUTTONS (Hecho / Mañana / Descartar) as desktop notifications.

A user service on the laptop. It READS the presence inbox (GET ...&all=1: never acks, so it does not compete with
the Coucou app or mochi-pc-agent) and, for each new notice that carries buttons and has not been acted on, while
this laptop is the device in use, shows a GNOME notification with those buttons. A press is sent to the presence
server (`POST /api/mochi/act`); a worker on the server applies it (resolve the pendiente, snooze...).

Only notices WITH buttons are handled here: plain ones keep going through the island / mochi-pc-agent as before.
The first run starts after what is already in the inbox (no backlog of old notices).
`touch ~/.config/jinx/notice-actions.off` stops it showing anything; `jinx-notice-actions --check` is a dry run.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import threading
import time
import urllib.request
from pathlib import Path

HOME = Path.home()
PRESENCE = os.environ.get("JINX_PRESENCE_URL", "http://100.92.254.125:8897")
KEY_FILE = HOME / ".config/mochi-presence/key"
OFF_FILE = HOME / ".config/jinx/notice-actions.off"
STATE = Path(os.environ.get("JINX_NOTICE_STATE", HOME / ".local/state/jinx-notice-actions.json"))
LOG = Path(os.environ.get("JINX_NOTICE_LOG", HOME / "jinx-emergencia/logs/notice-actions.log"))
ME = "pc"
POLL_S = 4
MAX_AGE_S = 6 * 3600     # an older notice is not worth a popup (it would be a stale reminder)
MAX_OPEN = 6             # notifications waiting for a click at once


# ---------- pure (unit-tested) ----------

def should_show(msg: dict, active_device: str, now: float, open_count: int, switched_off: bool) -> tuple[bool, str]:
    if switched_off:
        return False, "off"
    if active_device != "pc":
        return False, f"device in use is {active_device}"
    if not msg.get("actions"):
        return False, "no buttons"
    if msg.get("acted"):
        return False, "already acted on"
    if now - float(msg.get("ts", now)) > MAX_AGE_S:
        return False, "stale"
    if open_count >= MAX_OPEN:
        return False, "too many open"
    return True, "ok"


def build_command(msg: dict) -> list[str]:
    """notify-send with one `-A id=Label` per button. `-A` implies --wait and prints the chosen id on stdout."""
    urgency = "critical" if msg.get("kind") == "alert" else "normal"
    cmd = ["notify-send", "-a", "Jinx", "-u", urgency, "-i", "dialog-information"]
    for a in msg["actions"]:
        cmd += ["-A", f"{a['id']}={a['label']}"]
    return cmd + ["Jinx", str(msg.get("text", ""))[:300]]


def chosen_action(stdout: str, msg: dict) -> str | None:
    """The button pressed, if it is one of the notice's own (a dismissed notification prints nothing)."""
    pick = stdout.strip().splitlines()[-1].strip() if stdout.strip() else ""
    return pick if pick in {a["id"] for a in msg.get("actions", [])} else None


# ---------- effects ----------

def log(text: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {text}\n")


def api(path: str, key: str, body: dict | None = None) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(PRESENCE + path, data=data,
                                 headers={"X-Mochi-Key": key, "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=6) as r:
        return json.loads(r.read())


open_count = 0
open_lock = threading.Lock()


def show_and_wait(msg: dict, key: str) -> None:
    """Runs in a thread: shows the notification and waits for the click (or for it to be dismissed)."""
    global open_count
    try:
        out = subprocess.run(build_command(msg), capture_output=True, text=True, timeout=12 * 3600).stdout
        action = chosen_action(out, msg)
        if action is None:
            log(f"#{msg['id']} dismissed without a button")
            return
        res = api("/api/mochi/act", key, {"id": msg["id"], "action": action, "by": ME})
        log(f"#{msg['id']} pressed {action}: {res}")
    except Exception as e:  # noqa: BLE001
        log(f"#{msg.get('id')} failed: {e}")
    finally:
        with open_lock:
            open_count -= 1


def load_state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def check(key: str) -> int:
    data = api("/api/mochi/inbox?since_id=0&all=1", key)
    print(f"device in use: {data.get('active_device')}   switched off: {OFF_FILE.exists()}")
    for m in sorted(data.get("messages", []), key=lambda x: x["id"])[-8:]:
        ok, why = should_show(m, data.get("active_device", "?"), time.time(), 0, OFF_FILE.exists())
        btn = ",".join(a["id"] for a in m.get("actions", [])) or "-"
        print(f"  #{m['id']} buttons[{btn}] {'WOULD SHOW' if ok else 'silent: ' + why:<28} {m['text'][:60]!r}")
    return 0


def main() -> int:
    global open_count
    key = KEY_FILE.read_text().strip()
    if "--check" in sys.argv:
        return check(key)
    st = load_state()
    while True:
        try:
            data = api(f"/api/mochi/inbox?since_id={st.get('last_id', 0)}&all=1", key)
            msgs = sorted(data.get("messages", []), key=lambda m: m["id"])
            if "last_id" not in st:                       # first run: never pop up the backlog
                st["last_id"] = max((m["id"] for m in msgs), default=0)
                log(f"first run: starting after #{st['last_id']}")
            else:
                for m in msgs:
                    with open_lock:
                        n = open_count
                    ok, why = should_show(m, data.get("active_device", "?"), time.time(), n, OFF_FILE.exists())
                    if ok:
                        with open_lock:
                            open_count += 1
                        threading.Thread(target=show_and_wait, args=(m, key), daemon=True).start()
                        log(f"#{m['id']} shown with {[a['id'] for a in m['actions']]}")
                    elif m.get("actions"):
                        log(f"#{m['id']} not shown: {why}")
                    st["last_id"] = m["id"]
            STATE.parent.mkdir(parents=True, exist_ok=True)
            STATE.write_text(json.dumps(st))
        except Exception as e:  # noqa: BLE001  (server unreachable: keep trying)
            log(f"poll error: {e}")
        time.sleep(POLL_S)


if __name__ == "__main__":
    sys.exit(main())
