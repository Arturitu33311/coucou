{
  "name": "jinx-g2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jinx en las gafas Even G2 (app de Even Hub). Habla con jinx/g2-bridge.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "pack": "node scripts/make-manifest.mjs && npm run build && evenhub pack app.json dist -o jinx.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
